<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows 11 24H2 and later: no console of its own when opened from Explorer (the GUI); in a terminal the
     console program shares the terminal's console, and shells wait for it (the command line). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <consoleAllocationPolicy xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">detached</consoleAllocationPolicy>
    </windowsSettings>
  </application>
</assembly>
